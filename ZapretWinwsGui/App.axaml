<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ZapretWinwsGui.App"
             xmlns:local="using:ZapretWinwsGui"
             xmlns:vm="using:ZapretWinwsGui.ViewModels"
             x:DataType="vm:MainViewModel"
             RequestedThemeVariant="Default">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/avalonia-logo.ico"
                      ToolTipText="{Binding TrayToolTip}"
                      Command="{Binding ShowMainWindowCommand}">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Панель управления" Command="{Binding ShowMainWindowCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Запустить winws" Command="{Binding StartProcessCommand}" />
                        <NativeMenuItem Header="Остановить winws" Command="{Binding StopProcessCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Выход" Command="{Binding ExitApplicationCommand}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
